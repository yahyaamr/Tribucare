# Copy to .env.local for development. In production, set these in the Vercel
# dashboard (Settings → Environment Variables) and redeploy.

# ---- Public site --------------------------------------------------------------
# Canonical origin for every absolute URL the site emits: canonical links,
# hreflang, Open Graph, sitemap, robots.txt and structured data. Set this to the
# production domain before submitting the site to Google Search Console.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Search Console "HTML tag" verification token (the content= value only).
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools msvalidate.01 token, optional.
BING_SITE_VERIFICATION=

# Where the partnership form, the newsletter and the product request forms POST
# their JSON. Until set, the forms say they cannot send rather than dropping the
# enquiry. See lib/forms.ts.
NEXT_PUBLIC_INQUIRY_ENDPOINT=

# ---- Blog admin (/admin) ------------------------------------------------------
# Shared password for the panel. Changing it signs everyone out.
ADMIN_PASSWORD=
# Optional. Without it the session key derives from the password.
ADMIN_SESSION_SECRET=
# Injected automatically when a Vercel Blob store is connected to the project.
# Locally, leave unset: posts go to .cms-data/ and uploads to public/uploads/.
BLOB_READ_WRITE_TOKEN=
